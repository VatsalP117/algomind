{
  "manifest_version": 3,
  "name": "Algomind Quick Save",
  "version": "0.1.0",
  "description": "Quick-save solved LeetCode problems to Algomind.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://algomind.pro/*",
    "http://localhost:8080/*"
  ],
  "action": {
    "default_title": "Algomind Quick Save",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
