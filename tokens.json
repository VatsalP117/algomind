  "shared": {
    "typography": {
      "family": {
        "display": "'Plus Jakarta Sans', system-ui, sans-serif",
        "body":    "'DM Sans', system-ui, sans-serif",
        "mono":    "'JetBrains Mono', 'Fira Code', monospace"
      },
      "scale": {
        "xs":      "0.75rem",
        "sm":      "0.8125rem",
        "base":    "0.875rem",
        "md":      "1rem",
        "lg":      "1.125rem",
        "xl":      "1.375rem",
        "2xl":     "1.75rem",
        "3xl":     "2.25rem",
        "display": "clamp(2rem, 5vw, 3.5rem)"
      },
      "weight": {
        "light":    "300",
        "normal":   "400",
        "medium":   "500",
        "semibold": "600",
        "bold":     "700"
      },
      "leading": {
        "tight":   "1.1",
        "snug":    "1.35",
        "normal":  "1.6",
        "relaxed": "1.75"
      },
      "tracking": {
        "tightest": "-0.04em",
        "tight":    "-0.02em",
        "normal":   "0",
        "wide":     "0.04em",
        "widest":     "0.08em"
      }
    },
    "spacing": {
      "1": "4px",   "2": "8px",   "3": "12px",  "4": "16px",
      "5": "20px",  "6": "24px",  "8": "32px",  "10": "40px",
      "12": "48px", "16": "64px", "20": "80px",  "24": "96px"
    },
    "radius": {
      "none": "0px",
      "xs":   "2px",
      "sm":   "4px",
      "md":   "6px",
      "lg":   "8px",
      "xl":   "12px",
      "full": "9999px"
    },
    "shadow": {
      "none":   "none",
      "policy": "borders preferred — use 1px borders and surface color changes for depth, not shadows"
    },
    "motion": {
      "duration": {
        "instant": "75ms",
        "fast":    "100ms",
        "normal":  "150ms",
        "slow":    "300ms"
      },
      "easing": {
        "default":   "ease-out",
        "enter":     "ease-out",
        "exit":      "ease-in",
        "emphasis":  "cubic-bezier(0.34, 1.56, 0.64, 1)"
      }
    },
    "breakpoints": {
      "sm":  "640px",
      "md":  "768px",
      "lg":  "1024px",
      "xl":  "1280px",
      "2xl": "1536px"
    }
  }
